# ==============================================================================
# DOCUQUERY AI - RAG ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Google Gemini (Recommended Cloud LLM)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 2. Ollama Local Model (Air-gapped / Local Privacy)
# Run `ollama serve` locally on default port 11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# 3. Groq (High-Speed Cloud Inference)
# Get a free key at https://console.groq.com/keys
OPENAI_API_KEY=your_groq_or_openai_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# 4. Django Application Settings
DEBUG=True
SECRET_KEY=your_django_secret_key_here
